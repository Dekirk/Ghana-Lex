// Ghana Lex AI — Prisma schema
// Models the full domain: users (4 roles), firms, cases, parties,
// documents/evidence, reminders, invoices, and AI search history.
// NOTE: SQLite has no native enums — we use String + code-level validation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  role         String     @default("LITIGANT") // ADMIN | LAWYER | JUDGE | LITIGANT
  // Public-facing alphanumeric code, e.g. "GH-LX-1024"
  userCode     String     @unique
  firmId       String?
  firm         Firm?      @relation(fields: [firmId], references: [id])
  barNumber    String?
  phone        String?
  createdAt    DateTime   @default(now())
  caseParties  CaseParty[]
  ownedCases   Case[]
  judgedCases  Case[]     @relation("CaseJudge")
  reminders    Reminder[]
  invoices     Invoice[]
  aiQueries    AiQuery[]
}

model Firm {
  id         String   @id @default(cuid())
  name       String
  address    String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  members    User[]
  cases      Case[]
}

model Case {
  id            String      @id @default(cuid())
  // Public-facing case code, e.g. "GLX-CS-2026-0014"
  caseCode      String      @unique
  title         String
  caseType      String      @default("CIVIL")
  suitType      String      @default("PLAINTIFF_DEFENDANT")
  court         String
  division      String?
  judgeId       String?
  judge         User?       @relation("CaseJudge", fields: [judgeId], references: [id])
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id])
  firmId        String?
  firm          Firm?       @relation(fields: [firmId], references: [id])
  status        String      @default("FILED")
  filedAt       DateTime    @default(now())
  nextHearingAt DateTime?
  description   String?
  parties       CaseParty[]
  documents     Document[]
  reminders     Reminder[]
  invoices      Invoice[]
  milestones    Milestone[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CaseParty {
  id           String      @id @default(cuid())
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  // PLAINTIFF | DEFENDANT | APPELLANT | RESPONDENT | PETITIONER
  partyRole    String
  fullName     String
  contact      String?
  legalCounsel String?
  createdAt    DateTime     @default(now())
  documents    Document[]
}

model Document {
  id           String     @id @default(cuid())
  caseId       String
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  partyId      String?
  party        CaseParty? @relation(fields: [partyId], references: [id])
  title        String
  docType      String     @default("OTHER")
  fileName     String
  fileUrl      String?
  fileSizeKb   Int        @default(0)
  uploadedAt   DateTime   @default(now())
  notes        String?
  isEvidence   Boolean    @default(false)
}

model Milestone {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("PENDING")
  eventDate   DateTime
  createdAt   DateTime @default(now())
}

model Reminder {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  title      String
  dueAt      DateTime
  priority   String   @default("MEDIUM")
  isDone     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Invoice {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  number      String   @unique
  description String
  amountCedi  Float
  status      String   @default("UNPAID")
  issuedAt    DateTime @default(now())
  dueAt       DateTime
  paidAt      DateTime?
  createdAt   DateTime @default(now())
}

model AiQuery {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  question   String
  answer     String
  verified   Boolean  @default(false)
  sources    String?
  createdAt  DateTime @default(now())
}
